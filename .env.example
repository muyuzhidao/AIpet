# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略。

# Tavily 搜索 API(https://tavily.com)。可填多个 key,逗号分隔以叠加免费额度。
TAVILY_API_KEYS=tvly-xxxxxxxx,tvly-yyyyyyyy

# —— 以下为后续步骤会用到的凭证,本步可留空 ——

# 第 3 步:X 内容检索(第三方 Grok,OpenAI 兼容)
# GROK_BASE_URL=
# GROK_API_KEY=

# 第 3 步:Reddit 官方 API(OAuth script app)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# 第 5 步:AI 分析(DeepSeek 官方,OpenAI 兼容)
# DEEPSEEK_API_KEY=
